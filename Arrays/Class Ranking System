public class ClassRankingSystem {

    static class Student {
        String name;
        int[] quizzes;

        Student(String name, int[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {
            int sum = 0;
            for (int i = 0; i < quizzes.length; i++) {
                sum += quizzes[i];
            }
            return (double) sum / quizzes.length;
        }
    }

    // Our own sort (bubble sort), highest average first
    static void sortByAverage(Student[] students) {
        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {
                if (students[j].getAverage() < students[j + 1].getAverage()) {
                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }
    }

    // Our own linear search, returns the rank (-1 if not found)
    static int findRank(Student[] students, String name) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].name.equals(name)) {
                // Rank = 1 + number of students with a higher average,
                // so tied students get the same rank
                int rank = 1;
                for (int j = 0; j < students.length; j++) {
                    if (students[j].getAverage() > students[i].getAverage()) {
                        rank++;
                    }
                }
                return rank;
            }
        }
        return -1;
    }

    public static void main(String[] args) {
        String[] names = {"elgave", "sven", "yohanze", "mike", "carl"};
        int[][] rawScores = {
            {90, 85, 88, 92},
            {70, 75, 80, 85},
            {88, 90, 85, 92},
            {95, 96, 94, 97},
            {60, 65, 70, 75}
        };

        // Build the Student array from the 2D array
        Student[] students = new Student[names.length];
        for (int i = 0; i < names.length; i++) {
            students[i] = new Student(names[i], rawScores[i]);
        }

        sortByAverage(students);

        System.out.println("Rank  Name    Average");
        int rank = 1;
        for (int i = 0; i < students.length; i++) {
            if (i > 0 && students[i].getAverage() != students[i - 1].getAverage()) {
                rank = i + 1;
            }
            boolean tie = (i > 0 && students[i].getAverage() == students[i - 1].getAverage())
                    || (i < students.length - 1
                    && students[i].getAverage() == students[i + 1].getAverage());

            System.out.printf("%-6d%-8s%.2f%s%n", rank, students[i].name,
                    students[i].getAverage(), tie ? " (tie)" : "");
        }

        System.out.println("Rank of yohanze: " + findRank(students, "yohanze"));
    }
}
