public class OverflowReferenceInvestigator {
    public static void main(String[] args) {
        // Overflow: a byte can only hold -128 to 127
        byte number = 127;
        number++;
        System.out.println("byte after increment: " + number); // -128

        // Strings: two with new String, one literal
        String s1 = new String("Java");
        String s2 = new String("Java");
        String s3 = "Java";

        System.out.println("s1 == s2: " + (s1 == s2));
        System.out.println("s1 == s3: " + (s1 == s3));
        System.out.println("s2 == s3: " + (s2 == s3));
        System.out.println("s1.equals(s2): " + s1.equals(s2));
        System.out.println("s1.equals(s3): " + s1.equals(s3));
        System.out.println("s2.equals(s3): " + s2.equals(s3));

        // s1 == s2 is false: each new String is a separate object.
        // s1 == s3 and s2 == s3 are false: s1 and s2 are new objects,
        // while s3 points to the literal in the String pool.
        // equals() is true for all because it compares the text.

        // Shared array: both variables point to one array
        int[] a = {1, 2, 3};
        int[] b = a;
        b[0] = 99;
        System.out.println("a[0]: " + a[0]); // 99, because a and b are the same array
    }
}
