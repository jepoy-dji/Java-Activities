public class CompoundGrowthTracker {
    public static void main(String[] args) {
        double balance = 1000;

        balance += 500;
        System.out.println("After += 500: " + balance);

        balance *= 2;
        System.out.println("After *= 2: " + balance);

        balance += 250;
        System.out.println("After += 250: " + balance);

        int count = 5;
        System.out.println("count++: " + count++); // prints 5
        System.out.println("count after: " + count); // prints 6

        count = 5;
        System.out.println("++count: " + ++count); // prints 6
        System.out.println("count after: " + count); // prints 6

        // count++ (postfix) gives the OLD value first, then adds 1.
        // ++count (prefix) adds 1 first, then gives the NEW value.
        // That is why the first print shows 5 and the second shows 6.
    }
}
