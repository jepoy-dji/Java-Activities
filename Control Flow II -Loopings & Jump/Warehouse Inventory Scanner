import java.util.Scanner;

public class WarehouseInventoryScanner {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[][] warehouse = {
            {10, 5, -1},
            {2, 8, 20},
            {15, -1, 4}
        }; // -1 means damaged shelf

        int choice;
        do {
            System.out.println("\n1. Total inventory");
            System.out.println("2. Find first critically low shelf");
            System.out.println("3. Restock a shelf");
            System.out.println("4. Exit");
            System.out.print("Choose: ");
            choice = sc.nextInt();

            if (choice == 1) {
                int total = 0;
                for (int i = 0; i < warehouse.length; i++) {
                    for (int j = 0; j < warehouse[i].length; j++) {
                        if (warehouse[i][j] == -1) {
                            continue; // skip damaged shelves
                        }
                        total += warehouse[i][j];
                    }
                }
                System.out.println("Total inventory: " + total);

            } else if (choice == 2) {
                boolean found = false;
                for (int i = 0; i < warehouse.length; i++) {
                    for (int j = 0; j < warehouse[i].length; j++) {
                        // critically low = 3 or less, and not damaged
                        if (warehouse[i][j] != -1 && warehouse[i][j] <= 3) {
                            System.out.println("First critically low shelf: row "
                                    + i + ", column " + j
                                    + " (" + warehouse[i][j] + " items)");
                            found = true;
                            break; // stops the inner loop
                        }
                    }
                    if (found) {
                        break; // stops the outer loop too
                    }
                }
                if (!found) {
                    System.out.println("No critically low shelf.");
                }

            } else if (choice == 3) {
                restock(warehouse, sc);

            } else if (choice != 4) {
                System.out.println("Invalid choice.");
            }
        } while (choice != 4);

        System.out.println("Goodbye!");
    }

    static void restock(int[][] warehouse, Scanner sc) {
        while (true) {
            System.out.print("Row: ");
            int r = sc.nextInt();
            System.out.print("Column: ");
            int c = sc.nextInt();
            System.out.print("Amount to add: ");
            int amount = sc.nextInt();

            if (r < 0 || r >= warehouse.length || c < 0 || c >= warehouse[0].length) {
                System.out.println("Invalid shelf location. Try again.");
            } else if (warehouse[r][c] == -1) {
                System.out.println("That shelf is damaged. Try again.");
            } else if (amount <= 0) {
                System.out.println("Amount must be more than 0. Try again.");
            } else {
                warehouse[r][c] += amount;
                System.out.println("Restocked. New count: " + warehouse[r][c]);
                return; // leaves the method once restocking succeeds
            }
        }
    }
}
